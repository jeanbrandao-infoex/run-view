# Directory must exist on the Docker daemon host, owned by 10001:10001.
INFOEX_RUN_DATA=/opt/infoex-run/data
# Generate locally; never commit the real value.
INFOEX_RUN_TOKEN=
# docker image inspect infoex-run-sandbox:local --format '{{.Id}}'
INFOEX_RUN_IMAGE=
# stat -c '%g' /var/run/docker.sock
DOCKER_SOCKET_GID=
# Docker network created once on the host with: docker network create --internal infoex-control
# Attach only the Infoex API and the Hub backend to this network.
INFOEX_RUN_CONTROL_NETWORK=infoex-control
